{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hge-gold/experiment-event-v1",
  "title": "Append-only experiment registry record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "experiment_id",
    "parent_hypothesis",
    "hypothesis_family",
    "timestamp_utc",
    "code_sha256",
    "config_sha256",
    "data_sha256",
    "dependency_sha256",
    "source_availability_convention",
    "feature_list",
    "target",
    "horizon",
    "model",
    "hyperparameters",
    "fold_definitions",
    "train_metrics",
    "validation_metrics",
    "calibration_metrics",
    "economic_metrics",
    "decision",
    "decision_reason",
    "declared_family_budget",
    "sequence",
    "previous_record_hash",
    "record_hash"
  ],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["promote", "reject", "failed"]},
    "declared_family_budget": {"type": "integer", "minimum": 1},
    "horizon": {"type": "integer", "minimum": 1},
    "feature_list": {"type": "array", "items": {"type": "string"}},
    "fold_definitions": {"type": "array"},
    "sequence": {"type": "integer", "minimum": 0},
    "previous_record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
